{
  "name": "@harness/apps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "kg:bootstrap": "pnpm --filter @harness/kg run bootstrap",
    "kg:reason": "pnpm --filter @harness/kg run reason",
    "kg:pipeline": "pnpm run kg:bootstrap && pnpm run kg:reason",
    "dev": "pnpm --filter @harness/kg-visualizer dev",
    "hub:dev": "pnpm --filter @harness/eval-hub dev",
    "hub:build": "pnpm --filter @harness/eval-hub build",
    "hub:start": "pnpm --filter @harness/eval-hub start",
    "hub:tui": "pnpm --filter @harness/eval-hub start:tui",
    "hub:server": "pnpm --filter @harness/eval-hub start:server",
    "hub:run": "node eval-hub/dist/index.js --run",
    "hub:skills": "node eval-hub/dist/index.js --run --layers skills",
    "hub:agents": "node eval-hub/dist/index.js --run --layers agents",
    "hub:recipes": "node eval-hub/dist/index.js --run --layers recipes",
    "hub:all": "node eval-hub/dist/index.js --run --layers skills,agents,recipes",
    "hub:report": "node eval-hub/dist/index.js --report",
    "hub:open": "node eval-hub/dist/index.js --open",
    "hub:export": "node eval-hub/dist/index.js --export-history",
    "hub:report:open": "node eval-hub/dist/index.js --report --open"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "node-gyp": "^11.5.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  }
}
