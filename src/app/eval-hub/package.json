{
  "name": "@harness/eval-hub",
  "version": "1.2.0",
  "type": "module",
  "license": "CECILL-B",
  "description": "Native TypeScript eval hub — TUI + HTTP API for the harness A/B evaluation pipeline",
  "main": "dist/index.js",
  "bin": {
    "eval-hub": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:tui": "node dist/index.js --tui",
    "start:server": "node dist/index.js --server --port 7331",
    "test": "pnpm run build && vitest run",
    "test:native": "node scripts/check-native-deps.mjs",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test smoke/",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "typecheck": "tsc --noEmit",
    "evaluate-release": "node dist/index.js --evaluate-harness-release",
    "cli:check-consistency": "node ./dist/index.js --check-consistency"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@rezi-ui/core": "0.1.0-beta.2",
    "@rezi-ui/node": "0.1.0-beta.2",
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.5.1",
    "hono": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yaml": "^2.7.0"
  },
  "files": [
    "dist/**",
    "LICENSE.CECILL-B"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./local-evaluation": "./dist/domains/local-evaluation/index.js",
    "./measurement/evalCoverage": "./dist/domains/measurement/evalCoverage.js"
  }
}
