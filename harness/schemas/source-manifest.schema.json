{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "project",
    "resolver",
    "components",
    "releaseExcludes",
    "pathSemantics"
  ],
  "properties": {
    "schema": {
      "const": "harness-source-manifest-v1"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "ownership",
          "targetSourcePath",
          "migrationState",
          "packagePolicy",
          "targets",
          "dependencies",
          "evaluation"
        ],
        "properties": {
          "currentRuntimePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetSourcePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "migrationState": {
            "enum": [
              "pending-git-move",
              "canonical-source",
              "external-lock-only"
            ]
          }
        }
      }
    },
    "pathSemantics": {
      "type": "object",
      "required": [
        "currentRuntimePath",
        "targetSourcePath",
        "runtimePath"
      ],
      "properties": {
        "currentRuntimePath": {
          "type": "string"
        },
        "targetSourcePath": {
          "type": "string"
        },
        "runtimePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "repository",
        "revisionPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revisionPolicy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resolver": {
      "type": "object",
      "required": [
        "name",
        "package",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "releaseExcludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
