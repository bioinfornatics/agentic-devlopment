{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "project",
    "resolver",
    "components",
    "releaseExcludes"
  ],
  "properties": {
    "schema": {
      "const": "harness-source-manifest-v1"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "ownership",
          "sourcePath",
          "packagePolicy",
          "targets",
          "dependencies",
          "evaluation"
        ]
      }
    }
  },
  "additionalProperties": false
}
