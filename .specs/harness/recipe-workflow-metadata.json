{
  "$schema": "../schemas/recipe-workflow-metadata.schema.json",
  "contract": "loop-engineering-active-v1",
  "recipes": {
    "implement": {
      "source_path": ".goose/recipes/implement.yaml",
      "phase": "The delegated builder must atomically claim the task before any write",
      "ad001_pattern": "specialist-orchestration-boundary",
      "entry_criteria": [
        "Load the Beads task and confirm it is ready, blockers are closed"
      ],
      "exit_criteria": [
        "persist compact candidate evidence references."
      ],
      "retry": {
        "max_retries": 3,
        "checks": [
          {
            "type": "shell",
            "command": "test -f .beads/issues.jsonl"
          },
          {
            "type": "shell",
            "command": "bd list --json >/dev/null"
          }
        ],
        "on_failure": "abort"
      },
      "session": {
        "max_tool_repetitions": 5
      },
      "controller_skills": [
        {
          "skill": "task-framing",
          "applicability": "always"
        }
      ],
      "delegates": [
        {
          "agent": "change-builder",
          "mandatory_skills": [
            "task-framing"
          ],
          "condition": "ready bounded implementation task"
        }
      ],
      "skills_extension_required": true
    },
    "loop-engineering": {
      "source_path": ".goose/recipes/loop-engineering.yaml",
      "phase": "Trigger -> Planner -> Builder -> Independent Verifier -> Memory -> Manager -> Controller.",
      "ad001_pattern": "orchestration",
      "entry_criteria": [
        "Beads is the sole durable runtime state."
      ],
      "exit_criteria": [
        "Emit and persist exactly one transition: CONTINUE, REWORK, REPLAN, WAIT, COMPLETE, ESCALATE, or ABORT."
      ],
      "retry": {
        "max_retries": 3,
        "checks": [
          {
            "type": "shell",
            "command": "test -f .beads/issues.jsonl"
          },
          {
            "type": "shell",
            "command": "python3 -c \"import json; [json.loads(l) for l in open('.beads/issues.jsonl') if l.strip()]\"  # Beads JSONL integrity"
          }
        ],
        "on_failure": "abort"
      },
      "session": {
        "max_tool_repetitions": 5
      },
      "controller_skills": [
        {
          "skill": "task-framing",
          "applicability": "planning and building"
        },
        {
          "skill": "evidence-verification",
          "applicability": "verification"
        },
        {
          "skill": "loop-control",
          "applicability": "controller transition"
        }
      ],
      "delegates": [
        {
          "agent": "repository-researcher",
          "mandatory_skills": [
            "task-framing"
          ],
          "condition": "material unknowns"
        },
        {
          "agent": "change-builder",
          "mandatory_skills": [
            "task-framing"
          ],
          "condition": "rework_count below 2"
        },
        {
          "agent": "change-builder-premium",
          "mandatory_skills": [
            "task-framing"
          ],
          "condition": "rework_count 2 through 3"
        },
        {
          "agent": "independent-verifier",
          "mandatory_skills": [
            "evidence-verification"
          ],
          "condition": "rework_count below 2"
        },
        {
          "agent": "independent-verifier-premium",
          "mandatory_skills": [
            "evidence-verification"
          ],
          "condition": "rework_count 2 through 3"
        }
      ],
      "skills_extension_required": true
    },
    "research": {
      "source_path": ".goose/recipes/research.yaml",
      "phase": "This phase delegates to repository-researcher in an isolated read-only session.",
      "ad001_pattern": "specialist-orchestration-boundary",
      "entry_criteria": [
        "Load the Beads run/task, spec, prior transitions, failures, evidence signatures, and budget."
      ],
      "exit_criteria": [
        "Return observed facts, inferences, constraints, tools/skills, verification commands, failure chronology, later-added evidence, risks, unknowns, and the smallest bounded task contract."
      ],
      "retry": {
        "max_retries": 3,
        "checks": [
          {
            "type": "shell",
            "command": "test -f .beads/issues.jsonl"
          }
        ],
        "on_failure": "abort"
      },
      "session": {
        "max_tool_repetitions": 5
      },
      "controller_skills": [
        {
          "skill": "task-framing",
          "applicability": "always"
        }
      ],
      "delegates": [
        {
          "agent": "repository-researcher",
          "mandatory_skills": [
            "task-framing"
          ],
          "condition": "material repository unknowns"
        }
      ],
      "skills_extension_required": true
    },
    "verify": {
      "source_path": ".goose/recipes/verify.yaml",
      "phase": "Delegate to independent-verifier in a new isolated session.",
      "ad001_pattern": "specialist-orchestration-boundary",
      "entry_criteria": [
        "Load the task, actual diff, builder_session, candidate evidence, prior verdicts, failure/evidence signatures, and budget."
      ],
      "exit_criteria": [
        "Persist criterion evidence and exactly one verdict: ACCEPTED, REWORK, REPLAN, BLOCKED, or ESCALATE."
      ],
      "retry": {
        "max_retries": 2,
        "checks": [
          {
            "type": "shell",
            "command": "test -f .beads/issues.jsonl"
          },
          {
            "type": "shell",
            "command": "bd list --json >/dev/null"
          }
        ],
        "on_failure": "abort"
      },
      "session": {
        "max_tool_repetitions": 5
      },
      "controller_skills": [
        {
          "skill": "evidence-verification",
          "applicability": "always"
        },
        {
          "skill": "loop-control",
          "applicability": "recovery recommendation after failure"
        }
      ],
      "delegates": [
        {
          "agent": "independent-verifier",
          "mandatory_skills": [
            "evidence-verification"
          ],
          "condition": "independent evidence verdict"
        }
      ],
      "skills_extension_required": true
    }
  },
  "agents": {
    "change-builder": {
      "mandatory_skills": [
        "task-framing"
      ]
    },
    "error-analyzer": {
      "mandatory_skills": [
        "loop-control"
      ]
    },
    "change-builder-premium": {
      "mandatory_skills": [
        "task-framing"
      ]
    },
    "independent-verifier": {
      "mandatory_skills": [
        "evidence-verification"
      ]
    },
    "independent-verifier-premium": {
      "mandatory_skills": [
        "evidence-verification"
      ]
    },
    "repository-researcher": {
      "mandatory_skills": [
        "task-framing"
      ]
    }
  }
}
