{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentic-devlopment.local/schemas/distribution-strategy-v1.json","type":"object","additionalProperties":false,
  "required":["schema","networkOptional","candidateBytesAuthoritative","resolver","components"],
  "properties":{
    "schema":{"const":"harness-distribution-strategy-v1"},"networkOptional":{"const":true},"candidateBytesAuthoritative":{"const":true},
    "resolver":{"type":"object","additionalProperties":false,"required":["package","version"],"properties":{"package":{"const":"skills"},"version":{"const":"1.5.20"}}},
    "components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}}
  },
  "$defs":{
    "nonblank":{"type":"string","pattern":".*\\S.*"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "command":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/nonblank"}},
    "source":{"type":"object","additionalProperties":false,"required":["repository","revision","path"],"properties":{"repository":{"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"revision":{"$ref":"#/$defs/revision"},"path":{"$ref":"#/$defs/nonblank"}}},
    "exemption":{"type":"object","additionalProperties":false,"required":["owner","reason","expiresAt"],"properties":{"owner":{"$ref":"#/$defs/nonblank"},"reason":{"$ref":"#/$defs/nonblank"},"expiresAt":{"type":"string","format":"date-time"}}},
    "component":{"type":"object","additionalProperties":false,"required":["id","kind","name","ownership","distributionType","candidate"],"properties":{
      "id":{"type":"string","pattern":"^(skill|agent|recipe|plugin):[^:]+$"},"kind":{"enum":["skill","agent","recipe","plugin"]},"name":{"$ref":"#/$defs/nonblank"},"ownership":{"enum":["internal","external"]},
      "distributionType":{"enum":["native-skill-package","native-goose-plugin","embedded-release","recipe-copy","agent-copy"]},
      "candidate":{"type":"object","additionalProperties":false,"required":["mode","authoritative"],"properties":{"mode":{"enum":["locked-resolver","release-copy"]},"authoritative":{"const":true},"command":{"$ref":"#/$defs/command"}}},
      "source":{"$ref":"#/$defs/source"},"nativeDistributionGate":{"type":"object","additionalProperties":false,"required":["optional","networkRequired","command"],"properties":{"optional":{"const":true},"networkRequired":{"const":true},"command":{"$ref":"#/$defs/command"}}},"exemption":{"$ref":"#/$defs/exemption"}
    },"allOf":[
      {"if":{"properties":{"distributionType":{"const":"native-skill-package"}},"required":["distributionType"]},"then":{"required":["source","nativeDistributionGate"],"properties":{"kind":{"const":"skill"},"ownership":{"const":"external"},"candidate":{"properties":{"mode":{"const":"locked-resolver"}},"required":["mode"]}}}},
      {"if":{"properties":{"distributionType":{"const":"native-goose-plugin"}},"required":["distributionType"]},"then":{"required":["source","nativeDistributionGate"],"properties":{"kind":{"const":"plugin"}}}},
      {"if":{"properties":{"distributionType":{"const":"embedded-release"}},"required":["distributionType"]},"then":{"required":["exemption"],"properties":{"candidate":{"properties":{"mode":{"const":"release-copy"}},"required":["mode"]}}}},
      {"if":{"properties":{"distributionType":{"const":"recipe-copy"}},"required":["distributionType"]},"then":{"properties":{"kind":{"const":"recipe"},"ownership":{"const":"internal"}}}},
      {"if":{"properties":{"distributionType":{"const":"agent-copy"}},"required":["distributionType"]},"then":{"properties":{"kind":{"const":"agent"},"ownership":{"const":"internal"}}}}
    ]}
  }
}
